# Copy to .env.local and fill in your OWN service credentials.
# Never commit .env.local.

# AI: at least one key for analysis/copy. OpenAI also enables image selection.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Supabase: required locally and on Vercel. Service role stays server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Database connection URI, used only by npm run migrate.
SUPABASE_DB_URL=

# Local initially; use your own public deployment URL when sharing demos.
NEXT_PUBLIC_DEMO_BASE_URL=http://localhost:3000
# Required for public cache invalidation and scheduled cleanup, respectively.
REVALIDATE_SECRET=
CRON_SECRET=

# Fictional branding. Templates accept {yritys}, {linkki}, and literal \n.
SENDER_NAME=Demo Author
AGENCY_NAME=Example Studio
AGENCY_WEBSITE=studio.example
EMAIL_SUBJECT_TEMPLATE="{yritys} — esimerkkisivusto"
EMAIL_BODY_TEMPLATE="Hei! Tässä esimerkkisivusto yritykselle {yritys}:\n{linkki}"
SMS_TEMPLATE="Hei! Tässä esimerkkisivusto yritykselle {yritys}: {linkki}\n-Demo Author"
DEMO_BANNER_LABEL=Esimerkkisivusto
DEMO_BANNER_TEXT="Tämä on kuvitteellinen esimerkki verkkosivujen uudistuksesta."
OUTREACH_REVIEWER_ID=demo-reviewer

# Optional email integration; EMAIL_FROM must use your verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_SENDER_NAME=
BLOB_READ_WRITE_TOKEN=

# Optional SMS integration. Blank credentials keep SMS in dry-run mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional canonical URL override for inbound signature verification.
TWILIO_WEBHOOK_URL=
